# How the client talks to the API.
#   mock — in-browser sample data from src/mocks (no backend needed). A "Sample data"
#          label is shown in the app. Refused in production builds unless
#          NEXT_PUBLIC_ALLOW_MOCK_IN_PRODUCTION=true (e.g. a design-review deployment).
#   live — the Django REST API at /api/v1/.
NEXT_PUBLIC_API_MODE=mock

# Django origin, used by the Next.js rewrite so /api/v1/* is same-origin (needed for
# the HttpOnly refresh cookie). Server-side only; never exposed to the browser.
DJANGO_API_ORIGIN=http://127.0.0.1:8000

# Optional help links shown in the top bar. Hidden when unset.
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_SUPPORT_URL=
